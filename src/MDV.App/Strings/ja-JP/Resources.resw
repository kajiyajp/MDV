<?xml version="1.0" encoding="utf-8"?>
<!--
  日本語(既定言語)の UI 文字列。
  言語を追加するときは docs/translations/Resources.template.resw を
  Strings/<言語タグ>/Resources.resw にコピーして翻訳する(docs/translations/README.md 参照)。
  キーを追加・変更したら、全言語とテンプレートにも同じキーを追加すること(テストで検査される)。
-->
<root>
